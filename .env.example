# -----------------------------------------------------------------------------
# Environment variable reference. Copy the relevant section into:
#   apps/web/.env.local      (read by Vite)
#   apps/mobile/.env.local   (read by Expo)
#
# Every variable below is PUBLIC: it is inlined into the client bundle at build
# time. Never put secrets (API keys, client secrets, signing keys) here — they
# belong on the server.
# -----------------------------------------------------------------------------

# --- Web (Vite) ---------------------------------------------------------------
# development | test | staging | production
VITE_APP_ENV=development
# Base URL of the backend API. Must be https:// in staging/production.
VITE_API_BASE_URL=
# Optional. Request timeout in milliseconds (default 15000).
VITE_API_TIMEOUT_MS=
# Optional. debug | info | warn | error | silent (default: debug in dev, warn in prod).
VITE_LOG_LEVEL=

# --- Mobile (Expo) ------------------------------------------------------------
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_API_TIMEOUT_MS=
EXPO_PUBLIC_LOG_LEVEL=
